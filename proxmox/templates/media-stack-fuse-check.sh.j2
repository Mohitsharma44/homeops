#!/bin/bash
# Checks if /mnt/debrid FUSE mount is healthy.
# Runs every 5 minutes via cron.
# If the mount is stale, auto-recovers by restarting Decypharr
# and all containers that depend on the FUSE mount.
set -euo pipefail

TEXTFILE_DIR="/var/lib/alloy/textfile"
COMPOSE_DIR="/opt/media-stack"
LOCKFILE="/tmp/fuse-recovery.lock"
LOG_TAG="fuse-check"

# Containers that mount /mnt/debrid and need restart on FUSE recovery
DEBRID_CONTAINERS=(jellyfin radarr sonarr bazarr tunarr)

write_metric() {
  cat > "${TEXTFILE_DIR}/rd_fuse.prom" <<EOF
# HELP rd_fuse_mount_healthy Whether /mnt/debrid FUSE mount is accessible (1=ok, 0=fail)
# TYPE rd_fuse_mount_healthy gauge
rd_fuse_mount_healthy $1
# HELP rd_fuse_recovery_timestamp_seconds Unix timestamp of last FUSE recovery attempt
# TYPE rd_fuse_recovery_timestamp_seconds gauge
rd_fuse_recovery_timestamp_seconds ${2:-0}
EOF
}

check_mount() {
  # Two checks: mountpoint exists AND we can list contents (catches stale mounts)
  mountpoint -q /mnt/debrid 2>/dev/null && \
    timeout 5 ls /mnt/debrid/__all__/ >/dev/null 2>&1
}

if check_mount; then
  write_metric 1 0
  exit 0
fi

# Mount is unhealthy — attempt recovery
logger -t "$LOG_TAG" "FUSE mount /mnt/debrid is stale or missing, attempting recovery"

# Prevent concurrent recovery attempts
if [ -f "$LOCKFILE" ]; then
  lock_age=$(( $(date +%s) - $(stat -c %Y "$LOCKFILE" 2>/dev/null || echo 0) ))
  if [ "$lock_age" -lt 300 ]; then
    logger -t "$LOG_TAG" "Recovery already in progress (lock age: ${lock_age}s), skipping"
    write_metric 0 0
    exit 1
  fi
  logger -t "$LOG_TAG" "Stale lock file (${lock_age}s old), removing"
  rm -f "$LOCKFILE"
fi
touch "$LOCKFILE"
trap 'rm -f "$LOCKFILE"' EXIT

recovery_ts=$(date +%s)

# Step 1: Force-unmount the stale FUSE mount
logger -t "$LOG_TAG" "Step 1: Force-unmounting stale FUSE at /mnt/debrid"
fusermount -uz /mnt/debrid 2>/dev/null || umount -l /mnt/debrid 2>/dev/null || true

# Step 2: Recreate mount point with correct ownership
logger -t "$LOG_TAG" "Step 2: Recreating mount point"
rm -rf /mnt/debrid 2>/dev/null || true
mkdir -p /mnt/debrid
chown {{ media_stack_puid }}:{{ media_stack_pgid }} /mnt/debrid

# Step 3: Ensure rshared propagation
mount --make-rshared / 2>/dev/null || true

# Step 4: Restart Decypharr (it will recreate the rclone FUSE mount)
logger -t "$LOG_TAG" "Step 3: Restarting Decypharr container"
cd "$COMPOSE_DIR"
docker compose restart decypharr

# Step 5: Wait for FUSE mount to come back (up to 90s)
logger -t "$LOG_TAG" "Step 4: Waiting for FUSE mount to become available"
for i in $(seq 1 18); do
  if check_mount; then
    logger -t "$LOG_TAG" "FUSE mount recovered after ${i}x5s"
    break
  fi
  sleep 5
done

if ! check_mount; then
  logger -t "$LOG_TAG" "ERROR: FUSE mount did not recover after 90s"
  write_metric 0 "$recovery_ts"
  exit 1
fi

# Step 6: Restart dependent containers so they pick up the new mount
logger -t "$LOG_TAG" "Step 5: Restarting dependent containers"
docker compose restart "${DEBRID_CONTAINERS[@]}"

# Step 7: Verify everything is healthy
sleep 10
if check_mount; then
  logger -t "$LOG_TAG" "Recovery complete — FUSE mount and containers restored"
  write_metric 1 "$recovery_ts"
else
  logger -t "$LOG_TAG" "ERROR: FUSE mount failed post-recovery verification"
  write_metric 0 "$recovery_ts"
  exit 1
fi
