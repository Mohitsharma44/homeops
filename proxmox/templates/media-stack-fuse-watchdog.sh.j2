#!/bin/bash
# Watches for Decypharr container stop/die events and cleans up
# the stale FUSE mount before Docker restarts the container.
# Runs as a systemd service alongside the Docker stack.
set -euo pipefail

LOG_TAG="fuse-watchdog"
MOUNT_PATH="/mnt/debrid"
COMPOSE_DIR="/opt/media-stack"
DEBRID_CONTAINERS=(jellyfin radarr sonarr bazarr tunarr)

cleanup_fuse() {
  logger -t "$LOG_TAG" "Decypharr stopped/died — cleaning stale FUSE mount"

  # Force-unmount the stale FUSE mount
  fusermount -uz "$MOUNT_PATH" 2>/dev/null || umount -l "$MOUNT_PATH" 2>/dev/null || true

  # Recreate mount point with correct ownership
  rm -rf "$MOUNT_PATH" 2>/dev/null || true
  mkdir -p "$MOUNT_PATH"
  chown {{ media_stack_puid }}:{{ media_stack_pgid }} "$MOUNT_PATH"

  # Ensure rshared propagation
  mount --make-rshared / 2>/dev/null || true

  logger -t "$LOG_TAG" "FUSE mount cleaned, waiting for Decypharr to come back healthy"

  # Wait for Decypharr healthcheck to pass (Docker will restart it)
  for i in $(seq 1 30); do
    health=$(docker inspect --format '{{ "{{" }}.State.Health.Status{{ "}}" }}' decypharr 2>/dev/null || echo "missing")
    if [ "$health" = "healthy" ]; then
      logger -t "$LOG_TAG" "Decypharr healthy after ${i}x5s, restarting dependent containers"
      cd "$COMPOSE_DIR"
      docker compose restart "${DEBRID_CONTAINERS[@]}" 2>/dev/null || true
      logger -t "$LOG_TAG" "Recovery complete"
      return 0
    fi
    sleep 5
  done

  logger -t "$LOG_TAG" "ERROR: Decypharr did not become healthy after 150s"
  return 1
}

logger -t "$LOG_TAG" "Started — watching for Decypharr container events"

# Listen for die events on the decypharr container
# docker events blocks and streams events as they occur
docker events \
  --filter "container=decypharr" \
  --filter "event=die" | while read -r event; do
    logger -t "$LOG_TAG" "Received event: $event"
    cleanup_fuse || true
done
