# Media Stack — rendered by Ansible, do not edit on host directly
# Re-deploy: ansible-playbook proxmox/media-stack.yml

networks:
  media-net:
    driver: bridge

services:

  decypharr:
    image: cy01/blackhole:beta
    container_name: decypharr
    environment:
      - PUID={{ media_stack_puid }}
      - PGID={{ media_stack_pgid }}
      - TZ=America/Vancouver
    ports:
      - "8282:8282"
    cap_add:
      - SYS_ADMIN
    devices:
      - /dev/fuse
    security_opt:
      - apparmor:unconfined
    volumes:
      - /opt/media-stack/config/decypharr/config.json:/app/config.json
      - /mnt/debrid:/mnt/debrid:rshared
      - /mnt/symlinks:/mnt/symlinks
    networks:
      - media-net
    restart: unless-stopped
    # FUSE mount healthcheck — all debrid-dependent services wait for this.
    # Decypharr runs rclone internally which mounts the FUSE filesystem at
    # /mnt/debrid. Without this check, downstream containers start before
    # the mount propagates and can't see debrid files.
    healthcheck:
      test: ["CMD", "ls", "/mnt/debrid/__all__/"]
      interval: 15s
      timeout: 5s
      retries: 10
      start_period: 30s

  jellyfin:
    image: jellyfin/jellyfin:latest
    container_name: jellyfin
    environment:
      - PUID={{ media_stack_puid }}
      - PGID={{ media_stack_pgid }}
      - TZ=America/Vancouver
      - JELLYFIN_PublishedServerUrl=http://{{ media_stack_ip }}
    ports:
      - "8096:8096"
    devices:
      - /dev/dri:/dev/dri
    tmpfs:
      - /config/transcodes:size=8G
    volumes:
      - /opt/media-stack/config/jellyfin:/config
      - /mnt/debrid:/mnt/debrid:rshared
      - /mnt/symlinks:/mnt/symlinks
      - /mnt/local-media:/media/local
    networks:
      - media-net
    depends_on:
      decypharr:
        condition: service_healthy
    restart: unless-stopped

  prowlarr:
    image: linuxserver/prowlarr:latest
    container_name: prowlarr
    environment:
      - PUID={{ media_stack_puid }}
      - PGID={{ media_stack_pgid }}
      - TZ=America/Vancouver
    ports:
      - "9696:9696"
    volumes:
      - /opt/media-stack/config/prowlarr:/config
    networks:
      - media-net
    restart: unless-stopped

  radarr:
    image: linuxserver/radarr:latest
    container_name: radarr
    environment:
      - PUID={{ media_stack_puid }}
      - PGID={{ media_stack_pgid }}
      - TZ=America/Vancouver
    ports:
      - "7878:7878"
    volumes:
      - /opt/media-stack/config/radarr:/config
      - /mnt/debrid:/mnt/debrid:rshared
      - /mnt/symlinks:/mnt/symlinks
      - /mnt/local-media:/mnt/local-media
    networks:
      - media-net
    depends_on:
      decypharr:
        condition: service_healthy
      prowlarr:
        condition: service_started
    restart: unless-stopped

  sonarr:
    image: linuxserver/sonarr:latest
    container_name: sonarr
    environment:
      - PUID={{ media_stack_puid }}
      - PGID={{ media_stack_pgid }}
      - TZ=America/Vancouver
    ports:
      - "8989:8989"
    volumes:
      - /opt/media-stack/config/sonarr:/config
      - /mnt/debrid:/mnt/debrid:rshared
      - /mnt/symlinks:/mnt/symlinks
      - /mnt/local-media:/mnt/local-media
    networks:
      - media-net
    depends_on:
      decypharr:
        condition: service_healthy
      prowlarr:
        condition: service_started
    restart: unless-stopped

  bazarr:
    image: linuxserver/bazarr:latest
    container_name: bazarr
    environment:
      - PUID={{ media_stack_puid }}
      - PGID={{ media_stack_pgid }}
      - TZ=America/Vancouver
    env_file:
      - .env
    ports:
      - "6767:6767"
    volumes:
      - /opt/media-stack/config/bazarr:/config
      - /mnt/debrid:/mnt/debrid:rshared
      - /mnt/symlinks:/mnt/symlinks
      - /mnt/local-media:/media/local
    networks:
      - media-net
    depends_on:
      decypharr:
        condition: service_healthy
      radarr:
        condition: service_started
      sonarr:
        condition: service_started
    restart: unless-stopped

  jellyseerr:
    image: fallenbagel/jellyseerr:latest
    container_name: jellyseerr
    environment:
      - PUID={{ media_stack_puid }}
      - PGID={{ media_stack_pgid }}
      - TZ=America/Vancouver
    ports:
      - "5055:5055"
    volumes:
      - /opt/media-stack/config/jellyseerr:/app/config
    networks:
      - media-net
    depends_on:
      - jellyfin
      - radarr
      - sonarr
    restart: unless-stopped

  suggestarr:
    image: ciuse99/suggestarr:latest
    container_name: suggestarr
    environment:
      - PUID={{ media_stack_puid }}
      - PGID={{ media_stack_pgid }}
      - TZ=America/Vancouver
    env_file:
      - .env
    ports:
      - "5000:5000"
    volumes:
      - /opt/media-stack/config/suggestarr:/app/config/config_files
    networks:
      - media-net
    depends_on:
      - jellyfin
      - jellyseerr
    restart: unless-stopped

  tunarr:
    image: chrisbenincasa/tunarr:latest
    container_name: tunarr
    environment:
      - PUID={{ media_stack_puid }}
      - PGID={{ media_stack_pgid }}
      - TZ=America/Vancouver
    env_file:
      - .env
    ports:
      - "8000:8000"
    volumes:
      - /opt/media-stack/config/tunarr:/config
      - /mnt/debrid:/mnt/debrid:rshared
      - /mnt/symlinks:/mnt/symlinks
    networks:
      - media-net
    depends_on:
      decypharr:
        condition: service_healthy
      jellyfin:
        condition: service_started
    restart: unless-stopped

  # ── FlareSolverr (Cloudflare bypass for Prowlarr) ──
  flaresolverr:
    image: ghcr.io/flaresolverr/flaresolverr:latest
    container_name: flaresolverr
    environment:
      - TZ=America/Vancouver
      - LOG_LEVEL=info
    ports:
      - "8191:8191"
    networks:
      - media-net
    restart: unless-stopped

  # ── Tweakio (Torrentio proxy for Prowlarr) ─────────
  tweakio:
    image: varthe/tweakio:latest
    container_name: tweakio
    environment:
      - TZ=America/Vancouver
    ports:
      - "3185:3185"
    networks:
      - media-net
    restart: unless-stopped

  profilarr:
    image: santiagosayshey/profilarr:latest
    container_name: profilarr
    environment:
      - PUID={{ media_stack_puid }}
      - PGID={{ media_stack_pgid }}
      - TZ=America/Vancouver
    ports:
      - "6868:6868"
    volumes:
      - /opt/media-stack/config/profilarr:/config
    networks:
      - media-net
    depends_on:
      - radarr
      - sonarr
    restart: unless-stopped

  # cAdvisor removed — Alloy's built-in prometheus.exporter.cadvisor
  # provides container metrics with proper Docker container names.
  # Standalone cAdvisor in an LXC only sees cgroup paths, not names.

  # ── Monitoring: Scraparr (arr app metrics) ──────────
  # Note: ${VAR} syntax is resolved by Docker Compose from the .env file.
  # Do NOT use env_file here — it would leak unrelated secrets into this container.
  scraparr:
    image: ghcr.io/thecfu/scraparr:latest
    container_name: scraparr
    ports:
      - "127.0.0.1:7100:7100"
    environment:
      - RADARR_URL=http://radarr:7878
      - RADARR_API_KEY=${RADARR_API_KEY}
      - SONARR_URL=http://sonarr:8989
      - SONARR_API_KEY=${SONARR_API_KEY}
      - PROWLARR_URL=http://prowlarr:9696
      - PROWLARR_API_KEY=${PROWLARR_API_KEY}
      - PROWLARR_API_VERSION=v1
      - BAZARR_URL=http://bazarr:6767
      - BAZARR_API_KEY=${BAZARR_API_KEY}
    networks:
      - media-net
    depends_on:
      - radarr
      - sonarr
      - prowlarr
      - bazarr
    restart: unless-stopped
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

  # ── Zilean (debrid hash indexer for Prowlarr) ───────
  zilean:
    image: ipromknight/zilean:latest
    container_name: zilean
    ports:
      - "8181:8181"
    environment:
      - Zilean__Database__ConnectionString=Host=zilean-db;Port=5432;Database=zilean;Username=zilean;Password=${ZILEAN_DB_PASSWORD}
      - Zilean__Dmm__MinimumScoreMatch=0.85
      - TZ=America/Vancouver
    networks:
      - media-net
    depends_on:
      - zilean-db
    restart: unless-stopped
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

  zilean-db:
    image: postgres:16-alpine
    container_name: zilean-db
    environment:
      - POSTGRES_USER=zilean
      - POSTGRES_PASSWORD=${ZILEAN_DB_PASSWORD}
      - POSTGRES_DB=zilean
    volumes:
      - /opt/media-stack/config/zilean-db:/var/lib/postgresql/data
    networks:
      - media-net
    restart: unless-stopped
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

  # ── Analytics: Jellystat PostgreSQL ─────────────────
  jellystat-db:
    image: postgres:16-alpine
    container_name: jellystat-db
    environment:
      - POSTGRES_USER=jellystat
      - POSTGRES_PASSWORD=${JELLYSTAT_DB_PASSWORD}
      - POSTGRES_DB=jellystat
    volumes:
      - /opt/media-stack/config/jellystat-db:/var/lib/postgresql/data
    networks:
      - media-net
    restart: unless-stopped
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

  # ── Analytics: Jellystat (playback analytics UI) ────
  jellystat:
    image: cyfershepard/jellystat:latest
    container_name: jellystat
    ports:
      - "3000:3000"
    environment:
      - POSTGRES_USER=jellystat
      - POSTGRES_PASSWORD=${JELLYSTAT_DB_PASSWORD}
      - POSTGRES_IP=jellystat-db
      - POSTGRES_PORT=5432
      - JWT_SECRET=${JELLYSTAT_JWT_SECRET}
      - TZ=America/Vancouver
    depends_on:
      - jellystat-db
    networks:
      - media-net
    restart: unless-stopped
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
